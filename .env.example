NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/baloot_auth?schema=public
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
