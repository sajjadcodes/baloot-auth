NODE_ENV=development
PORT=3000
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
EMAIL_VERIFICATION_SECRET=
EMAIL_VERIFICATION_TTL_SECONDS=86400
RESEND_API_KEY=
AUTH_EMAIL_FROM=
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
PASSWORD_RESET_SECRET=
PASSWORD_RESET_TTL_SECONDS=900
PASSWORD_RESET_URL=http://localhost:5173/reset-password
REFRESH_SESSION_TTL_SECONDS=2592000
AUTH_COOKIE_SAME_SITE=lax
# Optional bootstrap clients for pnpm db:seed; put deployment values in untracked .env.
SEED_CLIENTS_JSON=[]
# Optional trusted bootstrap grants; target accounts must already be active and email-verified.
SEED_PLATFORM_ADMIN_USERS_JSON=[]
